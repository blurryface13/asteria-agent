# Copy to deploy/.env, replace every REPLACE_* value, then run:
# docker compose -f compose.yaml -f deploy/compose.gpu.yaml --env-file deploy/.env up -d --build
# Secrets must never be committed. Generate hex values with: openssl rand -hex 32
DB_PASSWORD=REPLACE_WITH_HEX_ONLY_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
ASTERIA_MODEL_SETTINGS_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
# Optional fallback. After admin login, set the DeepSeek key for all roles in
# Agent -> Models instead; no model key is required in this file at first boot.
DEEPSEEK_API_KEY=
# Optional only for Qwen-backed Modular RAG answer/rerank/evaluation features.
DASHSCOPE_API_KEY=
ASTERIA_ADMIN_EMAILS=admin@example.com

# Local-only by default. For Windows LAN access, keep this on localhost and
# choose either deploy/compose.lan.yaml (direct Docker publishing) or a
# restricted Windows portproxy. Never expose these HTTP ports to the Internet.
ASTERIA_BIND_HOST=127.0.0.1
# Optional host-only settings for a Windows portproxy deployment:
# ASTERIA_LAN_BIND_HOST=192.168.31.208
# ASTERIA_LAN_MODE=portproxy
CORS_ALLOW_ORIGINS=http://localhost:3023,http://127.0.0.1:3023
ASTERIA_COOKIE_SECURE=0

ASTERIA_SHARED_MODE=1
ASTERIA_DEV_AUTH_BYPASS=0
ASTERIA_EMAIL_LOGIN_ENABLED=0
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat
EMBEDDING=ollama:bge-m3
ASTERIA_MEMORY_EMBEDDING=ollama:bge-m3
ASTERIA_MEMORY_CHROMA_ENABLED=1
MODULAR_RAG_COLLECTION=research_papers
RETRIEVER=duckduckgo
