# ============ LLM ============
# Any LangChain-supported provider works (openai:gpt-4o, deepseek:deepseek-chat, ...)
DEEPSEEK_API_KEY=
# Optional dedicated encryption secret for administrator-set per-Agent API keys.
# Generate with `openssl rand -hex 32`; keep stable across API and Worker restarts.
# If unset, the server derives a separate encryption key from JWT_SECRET.
ASTERIA_MODEL_SETTINGS_SECRET=
DASHSCOPE_API_KEY=
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat

# ============ Retrieval ============
# duckduckgo needs no API key; tavily/bing/google need their own keys
RETRIEVER=duckduckgo

# ============ Embedding ============
# Local Ollama (free, offline): `ollama pull bge-m3` then `ollama serve`
EMBEDDING=ollama:bge-m3
OLLAMA_BASE_URL=http://localhost:11434
# Set this to the Windows host Ollama URL when API/Worker run in containers.
# Example: http://host.docker.internal:11434
ASTERIA_SOURCE_USER_AGENT=AsteriaResearch/1.0

# ============ Auth ============
# Generate a secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql://user@localhost:5432/bunny_research

# Small laboratory deployment: provision accounts with scripts/manage-lab.py.
# Password login is the default; do not expose the development auth bypass.
ASTERIA_SHARED_MODE=1
ASTERIA_ADMIN_EMAILS=
ASTERIA_REDIS_URL=redis://127.0.0.1:6379/4
ASTERIA_EMAIL_LOGIN_ENABLED=0
ASTERIA_DEV_AUTH_BYPASS=0
ASTERIA_API_PORT=8018
# Set 0.0.0.0 only behind an authenticated/restricted network and HTTPS proxy.
ASTERIA_API_HOST=127.0.0.1

# ============ SMTP (optional; only when ASTERIA_EMAIL_LOGIN_ENABLED=1) ============
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ============ Misc ============
DOC_PATH=./my-docs

# Markdown is the editable memory source; Redis caches recent conversation;
# ChromaDB indexes personal/project topic memories for semantic recall.
ASTERIA_WORKSPACES_ROOT=./workspaces
ASTERIA_MEMORY_CHROMA_ENABLED=1
ASTERIA_MEMORY_CHROMA_DIR=./workspaces/.memory-chroma
ASTERIA_MEMORY_EMBEDDING=ollama:bge-m3

# ============ Context filtering (research pipeline) ============
# hybrid = BM25 + dense + RRF fusion + near-duplicate removal (recommended)
# dense  = original single-signal embedding threshold pipeline
CONTEXT_FILTER_MODE=hybrid
# Local embedding stability knobs. Keep dense embedding enabled, but avoid
# sending many huge concurrent requests to Ollama when web/PDF scraping yields
# hundreds of chunks per sub-query.
CONTEXT_EMBED_BATCH=32
CONTEXT_EMBED_CONCURRENCY=1
# CONTEXT_RERANK=true    # optional LLM rerank of final cut (~1.2s/sub-query)
