# Authentication stays enabled for a shared/lab deployment.
NEXT_PUBLIC_ASTERIA_DEV_AUTH_BYPASS=0

# For development on the same machine as the browser and API:
NEXT_PUBLIC_ASTERIA_API_URL=http://127.0.0.1:8018
# When another person opens the frontend from their own computer, replace the
# loopback address above with the API's reachable HTTPS/LAN address. This is a
# browser-visible setting, not just the Next.js server's upstream URL.
